---
extends: default
ignore: |
  homelab/
  tests/output/
rules:
  line-length:
    max: 160
    ignore: |
      .github/workflows/
  truthy:
    allowed-values: ["true", "false"]
    ignore: |
      .github/workflows/
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
